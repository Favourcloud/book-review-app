# Eze Favour | DMI Week 11 Assignment 6
# Example values only. Generate unique secrets in an untracked .env.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
DB_PASS=replace-with-random-application-password
JWT_SECRET=replace-with-at-least-32-random-bytes
BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://YOUR_VM_PUBLIC_IP:3000
# Next.js embeds this value at build time. Rebuild after changing the host.
NEXT_PUBLIC_API_URL=http://YOUR_VM_PUBLIC_IP:3001/api
